# Arboreal Arcade — environment variables
# Copy to .env.local and fill in from the Arcade Supabase project.

# Supabase (Arcade project)
NEXT_PUBLIC_SUPABASE_URL=https://your-arcade-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Public site URL for metadata/links
NEXT_PUBLIC_SITE_URL=https://arcade.arborealplanet.com

# Optional: override for Lizard music bucket base URL
# NEXT_PUBLIC_LIZARD_MUSIC_URL=
